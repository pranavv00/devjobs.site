---
import '../../../src/app/globals.css';
import Navigation from '@shared/Navigation';
import SiteFooter from '@shared/SiteFooter';
import { SITE_URL, SITE_DESCRIPTION, absoluteUrl } from '@shared/seo';
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogType?: string;
  noindex?: boolean;
}
const {
  title,
  description = SITE_DESCRIPTION,
  canonical = Astro.url.pathname,
  ogType = 'website',
  noindex = false,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0f12" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
    />
    <link rel="canonical" href={absoluteUrl(canonical)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="DevJobs jobs feed"
      href="/feed.xml"
    />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="DevJobs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absoluteUrl(canonical)} />
    <meta property="og:image" content={`${SITE_URL}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="DevJobs — Great work. From anywhere." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_URL}/og-image.png`} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to main content
    </a>
    <Navigation client:load />
    <main id="main-content" class="shell main-content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
