---
import BaseLayout from '@/layouts/BaseLayout.astro';
import JobCard from '@shared/JobCard';
import { getActiveJobs, toSummary } from '@shared/data';
import { DEFAULT_FILTERS, filterJobs } from '@shared/jobs';
import { CATEGORIES, collectionSchema, serializeJsonLd } from '@shared/seo';
export function getStaticPaths() {
  return CATEGORIES.map((category) => ({
    params: { keyword: category.slug },
    props: { category },
  }));
}
const { category } = Astro.props;
const jobs = filterJobs(getActiveJobs().map(toSummary), {
  ...DEFAULT_FILTERS,
  query: category.query,
});
---
<BaseLayout
  title={`${category.title} | DevJobs`}
  description={category.description}
  canonical={`/q/${category.slug}`}
  noindex={!jobs.length}
>
  <div class="page-content">
    <div class="page-heading">
      <p class="eyebrow">Explore by specialty</p>
      <h1>{category.title}</h1>
      <p>{category.description}</p>
    </div>
    <script
      type="application/ld+json"
      set:html={serializeJsonLd(collectionSchema(category.title, `/q/${category.slug}`, jobs))}
    />
    <p class="results-summary">
      {jobs.length} recent listings. Confirm availability and location requirements with the
      employer.
    </p>
    <div class="jobs-grid">
      {jobs.slice(0, 24).map((job) => (
        <JobCard job={job} client:load />
      ))}
    </div>
    {!jobs.length && (
      <div class="empty-state">
        <h2>No recent listings in this category.</h2>
        <p>Browse other skills or check again after the next refresh.</p>
      </div>
    )}
    <div class="load-more">
      <a class="button button-secondary" href={`/jobs?q=${encodeURIComponent(category.query)}`}>
        Explore all matching jobs ↗
      </a>
    </div>
  </div>
</BaseLayout>
