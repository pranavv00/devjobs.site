---
import BaseLayout from '@/layouts/BaseLayout.astro';
import JobDetails from '@shared/JobDetails';
import { getAllJobs, toSummary } from '@shared/data';
import { breadcrumbSchema, jobSchema, serializeJsonLd } from '@shared/seo';
export function getStaticPaths() {
  return getAllJobs().map((job) => ({ params: { slug: job.slug }, props: { job } }));
}
const { job } = Astro.props;
const description = `${job.title} at ${job.company}. ${job.excerpt}`.slice(0, 160);
const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Remote jobs', path: '/jobs' },
    { name: job.title, path: `/jobs/${job.slug}` },
  ]),
  jobSchema(job),
].filter(Boolean);
---
<BaseLayout
  title={`${job.title} at ${job.company} | DevJobs`}
  description={description}
  canonical={`/jobs/${job.slug}`}
  ogType="article"
  noindex={job.archived}
>
  <script type="application/ld+json" set:html={serializeJsonLd(schema)} />
  <JobDetails job={job} summary={toSummary(job)} client:load />
</BaseLayout>
