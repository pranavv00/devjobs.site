---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | DevJobs" noindex>
  <div class="page-content">
    <div class="empty-state">
      <h1>This opportunity has moved on.</h1>
      <p>The page or job may have been removed. Explore more recent opportunities.</p>
      <a href="/jobs" class="button button-primary">
        Browse remote jobs ↗
      </a>
    </div>
  </div>
</BaseLayout>
